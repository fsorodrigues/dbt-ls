Output docs/images/macro-go-to-definition.gif

Require nvim

Set Width 1200
Set Height 600
Set Padding 5
Set Margin 80
Set MarginFill "#6B50FF"
Set FontSize 16
Set TypingSpeed 50ms

Type "nvim models/addresses.sql"
Enter
Sleep 1s

Hide
Type " sk"
Show

Sleep 0.5s
Type "jj"
Sleep 0.5s
Type "eee"
Sleep 0.5s
Type "gd"
Sleep 1s
